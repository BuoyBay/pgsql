' PostgreSQL backend for the stdlib's abstract Database base class.
'
' PgDatabase/PgRowSet implement the six-primitive Database contract, so every
' inherited helper (Query Of T, Insert, Update, transactions, *Async mirrors)
' works unchanged. On top of that contract this module adds what the bundled
' `postgres` package leaves out:
'
' - Real parameter binding. Values travel out of band through PQexecParams;
'   they are never spliced into the SQL text. `?` placeholders are rewritten
'   to `$1..$n` (skipping string literals, quoted identifiers, comments and
'   dollar-quoted bodies); `??` is a literal `?` for the jsonb operators.
' - Lossless values. Doubles are sent with round-trip precision, bytea
'   travels as binary, and numeric/timestamp/uuid/json text is available
'   exactly through PgRowSet.ValueText.
' - Streaming cursors (QueryStream) built on libpq's chunked-rows mode.
' - Prepared statements (Prepare -> PgStatement), LISTEN/NOTIFY, COPY in and
'   out, large objects, cancellation, and PgException with SQLSTATE fields.
'
' Buoy's FFI has no array marshaling, so the C arrays PQexecParams takes
' (char**, int*, Oid*) are assembled byte by byte in Bytes buffers. Every
' supported target is little-endian with 8-byte pointers.

' ── libpq FFI (private to this module) ─────────────────────────────────────

Const CONNECTION_OK = 0

Const PGRES_EMPTY_QUERY  = 0
Const PGRES_COMMAND_OK   = 1
Const PGRES_TUPLES_OK    = 2
Const PGRES_COPY_OUT     = 3
Const PGRES_COPY_IN      = 4
Const PGRES_TUPLES_CHUNK = 12

Const PQTRANS_IDLE    = 0
Const PQTRANS_ACTIVE  = 1
Const PQTRANS_INTRANS = 2
Const PQTRANS_INERROR = 3

Const INV_WRITE = 131072
Const INV_READ  = 262144

' Field codes for PQresultErrorField (postgres_ext.h PG_DIAG_*).
Const PG_DIAG_SEVERITY_NONLOCALIZED        = 86
Const PG_DIAG_SQLSTATE        = 67
Const PG_DIAG_MESSAGE_PRIMARY = 77
Const PG_DIAG_MESSAGE_DETAIL  = 68
Const PG_DIAG_MESSAGE_HINT    = 72
Const PG_DIAG_POSITION        = 80
Const PG_DIAG_SCHEMA_NAME     = 115
Const PG_DIAG_TABLE_NAME      = 116
Const PG_DIAG_COLUMN_NAME     = 99
Const PG_DIAG_CONSTRAINT_NAME = 110

Const PG_COPY_CHUNK = 1048576
Const PG_LO_CHUNK   = 262144

